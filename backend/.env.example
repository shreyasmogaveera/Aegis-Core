# AegisCore Application Layer — Example Environment Variables
PORT=5000
NODE_ENV=development
MONGO_URI=<MY_MONGODB_CONNECTION_STRING>
JWT_SECRET=<GENERATED_SECRET>
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=<GENERATED_SECRET>
ML_SERVICE_URL=http://localhost:5001/api/v1
DATA_SOURCE=mock
CORS_ORIGIN=http://localhost:5173
